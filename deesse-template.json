{
  "$schema": "https://raw.githubusercontent.com/deessejs/deessejs/main/templates/schema/template-v2.json",
  "name": "saas-template-multi-tenant",
  "slug": "saas-multitenant-starter",
  "title": "SaaS Multitenant Starter",
  "description": "A Next.js 16 monorepo with multi tenant organisations, isolated data per tenant and role based access, so you serve several customers from one deployment.",
  "version": "0.0.1",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "source": {
    "repo": "deessejs/saas-template-multi-tenant",
    "ref": "main"
  },
  "requires": {
    "runtime": "node",
    "node": "24.x",
    "packageManager": "pnpm@11.0.0"
  },
  "includes": ["**"],
  "excludes": [
    ".changeset/*.md",
    ".claude/settings.local.json",
    ".claude/agent-memory/**",
    ".claude/plans/**",
    ".claude/worktrees/**",
    ".claude/pr-body-*.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "CHANGELOG.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    "**/.env",
    "**/.env.*"
  ],
  "fileTypes": {
    "README.md": "doc",
    "LICENSE": "doc",
    "CONTRIBUTING.md": "doc",
    "AGENTS.md": "doc",
    "CLAUDE.md": "doc",
    ".changeset/config.json": "config",
    ".github/workflows/ci.yml": "ci",
    ".github/workflows/release.yml": "ci"
  }
}
