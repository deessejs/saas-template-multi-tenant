{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    }
  },
  "types": "./dist/auth.d.ts",
  "scripts": {
    "lint": "pnpm --dir ../../ exec oxlint --config .oxlintrc.json packages/auth --deny-warnings",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "auth:generate": "pnpm exec auth generate --config ./src/auth.ts --output ../database/src/schema/auth.ts --yes",
    "format": "pnpm --dir ../../ exec oxfmt --config .oxfmtrc.json --ignore-path .oxfmtignore \"packages/auth/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/env": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "vitest": "catalog:"
  }
}
